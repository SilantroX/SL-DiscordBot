# ==============================================================================
# CONFIGURACIÓN DEL BOT DE DISCORD - VARIABLES DE ENTORNO
# ==============================================================================
# Renombra o copia este archivo a ".env" y reemplaza los valores de ejemplo
# por las credenciales reales de tu aplicación en el Discord Developer Portal.
# NUNCA compartas ni subas tu archivo ".env" a repositorios públicos de GitHub.
# ==============================================================================

# Token secreto del Bot (obtenido en: https://discord.com/developers/applications -> Bot -> Token)
DISCORD_TOKEN=TU_TOKEN_SECRETO_AQUI

# ID del Servidor principal (Opcional, pero muy recomendado para sincronización instantánea de comandos Slash en desarrollo)
# Si se deja vacío, los comandos se sincronizarán globalmente (puede tardar hasta 1 hora en propagarse por Discord).
GUILD_ID=

# Prefijo para comandos de texto tradicionales (opcional, para utilidades de depuración)
COMMAND_PREFIX=!

# Ruta del archivo de base de datos SQLite (por defecto en la raíz del proyecto)
DATABASE_PATH=bot_database.sqlite3

# Entorno de ejecución: "development" o "production"
ENVIRONMENT=development
