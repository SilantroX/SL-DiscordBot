        <mxCell id="sec_news" value="📢 5. ANUNCIOS EN DISCORD (cogs/announcements.py)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFA500;fontColor=#000000;strokeColor=#CC8400;fontStyle=1;startSize=30;rounded=1;arcSize=8;" vertex="1" parent="1">
