<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Antigravity AI" version="24.0.0">
  <diagram name="Arquitectura y Flujos Bot Discord" id="bot-discord-arch">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" background="#f8f9fa" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- FILA 1: PLATAFORMA DISCORD Y BOT CORE -->
        <mxCell id="sec_discord" value="🌐 DISCORD ECOSYSTEM (API &amp; CLIENTS)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#5865F2;fontColor=#ffffff;strokeColor=#4752C4;fontStyle=1;startSize=30;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="460" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="usr_member" value="&lt;b&gt;👤 Usuario / Miembro&lt;/b&gt;&lt;br&gt;Interactúa con botones de roles, tickets y sugerencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5865F2;" vertex="1" parent="sec_discord">
          <mxGeometry x="20" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="usr_staff" value="&lt;b&gt;🛡️ Staff / Administrador&lt;/b&gt;&lt;br&gt;Envía /anuncio en privado, modera y atiende tickets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5865F2;" vertex="1" parent="sec_discord">
          <mxGeometry x="240" y="50" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="discord_gw" value="&lt;b&gt;⚡ Discord Gateway &amp;amp; REST API&lt;/b&gt;&lt;br&gt;WebSockets (eventos en tiempo real) + HTTP REST (roles, mensajes, canales)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebedef;strokeColor=#4752C4;fontStyle=0;" vertex="1" parent="sec_discord">
          <mxGeometry x="20" y="150" width="420" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="sec_core" value="🤖 BOT ENGINE (PYTHON 3.10+ / DISCORD.PY v2)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#2C2F33;fontColor=#ffffff;strokeColor=#23272A;fontStyle=1;startSize=30;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="40" width="560" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="core_main" value="&lt;b&gt;🚀 main.py&lt;/b&gt;&lt;br&gt;• Bot Class Initialization&lt;br&gt;• Slash Command Tree Sync&lt;br&gt;• Dynamic Cog Loader" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2C2F33;" vertex="1" parent="sec_core">
          <mxGeometry x="20" y="50" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="core_config" value="&lt;b&gt;⚙️ Config / .env&lt;/b&gt;&lt;br&gt;DISCORD_TOKEN&lt;br&gt;GUILD_ID, LOGS_CHANNELS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2C2F33;" vertex="1" parent="sec_core">
          <mxGeometry x="290" y="50" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="core_db" value="&lt;b&gt;💾 SQLite DB (aiosqlite)&lt;/b&gt;&lt;br&gt;Tablas: guild_settings, infractions, tickets, suggestions, role_menus, announcements" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#99AAB5;strokeColor=#7289DA;fontStyle=0;fontColor=#000000;" vertex="1" parent="sec_core">
          <mxGeometry x="100" y="150" width="370" height="90" as="geometry"/>
        </mxCell>

