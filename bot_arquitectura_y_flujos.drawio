        <!-- MÓDULO 1: ADMINISTRACIÓN -->
        <mxCell id="sec_admin" value="🛡️ 1. ADMINISTRACIÓN (cogs/admin.py)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ED4245;fontColor=#ffffff;strokeColor=#C03537;fontStyle=1;startSize=30;rounded=1;arcSize=8;" vertex="1" parent="1">
